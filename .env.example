# Supabase — server-side (backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mailcow — server-side only, never exposed to the frontend
MAILCOW_HOST=https://mail.yourdomain.co.zw
MAILCOW_API_KEY=your-mailcow-api-key

# Amazon SES outbound relay / smarthost
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SPF_INCLUDE=amazonses.com
MAILCOW_CONTAINER_NAME=postfix-mailcow
RELAY_MAP_PATH=/opt/postfix/conf/sender_dependent_relayhost_maps
VITE_SES_SPF_INCLUDE=amazonses.com

# Sendcorex outbound relay / smarthost
SENDCOREX_API_KEY=your-sendcorex-api-key
SENDCOREX_SMTP_HOST=smtp.sendcorex.com
SENDCOREX_SMTP_PORT=587
SENDCOREX_SPF_INCLUDE=sendcorex.com

# WhoisJSON — server-side only, never exposed to the frontend
# See README.md for instructions on obtaining this key
WHOISJSON_API_KEY=your-whoisjson-api-key

# Business Discovery (No Billing Required — Get a free key at locationiq.com)
LOCATIONIQ_API_KEY=your-locationiq-api-key

# Express server
PORT=3000

# Supabase — client-side (Vite frontend, VITE_ prefix required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# API base URL used by the frontend to reach the Express backend
VITE_API_BASE_URL=http://localhost:3000

# Paynow Zimbabwe
PAYNOW_INTEGRATION_ID=your-paynow-integration-id
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key

# Cloudflare
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Resend (transactional email)
RESEND_API_KEY=your-resend-api-key

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Application base URL (used for Paynow return URLs and email links)
APP_URL=http://localhost:3000

